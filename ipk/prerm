#!/bin/sh
# webOS Account uninstaller (runs as root via Preware/ipkgservice).
# Restores the pristine palmprofile service files and removes the app.
# The device profile account and token are left untouched.

APPID=com.palm.app.webosaccount
SVC=/usr/palm/services/com.palm.service.palmprofile
FILES="utils/palm_profile_util.js handlers/LoginProfileCommandAssistant.js handlers/IsEmailAvailableCommandAssistant.js handlers/GetTermsAndConditionsCommandAssistant.js handlers/GetTokenCommandAssistant.js handlers/GetAccountInfoAggregateAssistant.js services.json sources.json"

# Same check as postinst: on any other build postinst refused and changed
# nothing, so there is nothing here to undo.
OSINFO=`grep PRODUCT_VERSION_STRING /etc/palm-build-info 2>/dev/null | head -n 1`
OSVER=`echo "$OSINFO" | sed -e 's/.*[^0-9.]\([0-9][0-9]*\.[0-9][0-9.]*\).*/\1/'`
case "$OSVER" in
    3.0.5) ;;
    [12].*|3.0.*) OSVER=old ;;
    [0-9]*) ;;
    *) OSVER=old ;;
esac
case "$OSVER" in
    old)
        echo "webosaccount: not HP webOS 3.0.5 or webOS CE 3.1 or later (found '$OSINFO'), nothing to undo."
        exit 0
        ;;
esac

mount -o remount,rw / || exit 0

for f in $FILES; do
    if [ -f "$SVC/$f.stock" ]; then
        cp "$SVC/$f.stock" "$SVC/$f"
    fi
done
# Ours, never HP's — remove rather than restore. Must go together with the
# services.json/sources.json restore above, or the service would try to load a
# file that is no longer there.
rm -f "$SVC/handlers/UpdateUsernameCommandAssistant.js" \
      "$SVC/handlers/SyncDeviceNameCommandAssistant.js" \
      "$SVC/handlers/SignOutCommandAssistant.js"

rm -rf "/usr/palm/applications/$APPID"
kill $(ps | grep "[c]om.palm.service.palmprofile" | awk '{print $1}') >/dev/null 2>&1 || true
luna-send -n 1 palm://com.palm.applicationManager/rescan '{}' >/dev/null 2>&1 || true

exit 0
